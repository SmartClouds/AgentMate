{
  "name": "runova",
  "private": true,
  "version": "2.1.0",
  "description": "Runova: AI Agent Management Platform",
  "homepage": "https://runovahq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmartClouds/Runova.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @runova/core --filter @runova/protocol --filter @runova/studio --filter @runova/desktop dev",
    "build": "pnpm build:packages && pnpm --filter @runova/desktop build",
    "package": "pnpm --filter @runova/desktop package",
    "mobile": "pnpm --filter @runova/protocol build && pnpm --filter @runova/mobile start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "biome:ci": "biome ci .",
    "check:deprecated-deps": "node scripts/check-deprecated-deps.mjs",
    "check:deprecated-code": "biome lint --only=suspicious/noDeprecatedImports .",
    "check:legacy-names": "node scripts/check-legacy-names.mjs",
    "test:coverage": "pnpm build:packages && pnpm --filter @runova/core --filter @runova/protocol --filter @runova/studio --filter @runova/desktop test:coverage && node scripts/coverage-summary.mjs",
    "test:e2e": "pnpm build:packages && pnpm --filter @runova/desktop exec install-electron && pnpm --filter @runova/desktop rebuild:native && pnpm --filter @runova/desktop test:e2e",
    "build:packages": "pnpm --filter @runova/core --filter @runova/protocol --filter @runova/studio build",
    "test:unit": "pnpm build:packages && pnpm --filter @runova/core --filter @runova/protocol --filter @runova/studio --filter @runova/desktop test",
    "test:mobile": "pnpm --filter @runova/mobile test",
    "server-core:build": "node scripts/server-core.mjs build",
    "server-core:test": "node scripts/server-core.mjs test",
    "server-core:format": "node scripts/server-core.mjs format",
    "server-core:format:check": "node scripts/server-core.mjs format:check",
    "server-core:contracts": "node scripts/server-core.mjs contracts",
    "catalog:refresh-digests": "node scripts/refresh-catalog-digests.mjs",
    "server-core:publish": "node scripts/server-core.mjs publish",
    "wordpress-connector:test": "node scripts/wordpress-connector.mjs test",
    "wordpress-connector:lint": "node scripts/wordpress-connector.mjs lint",
    "wordpress-connector:compat": "node scripts/wordpress-connector.mjs compat",
    "wordpress-connector:build": "node scripts/wordpress-connector.mjs build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.1"
}
