<?xml version="1.0" encoding="utf-8"?>
<!--
  Every package comes from nuget.org and nowhere else. Source mapping makes a restore fail rather
  than quietly pick a package with the same name from another feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
