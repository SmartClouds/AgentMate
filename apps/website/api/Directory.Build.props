<Project>
  <!-- Shared by every project in the website API solution. Follows apps/server-core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- The site is English only and the chiseled image has no ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Restores are locked so CI builds exactly what was reviewed. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>

    <!-- Known vulnerabilities in any package, direct or transitive, fail the build when high or
         critical. Low and moderate ones stay visible as warnings, and so does a vulnerability
         feed that could not be reached (NU1900), so a network blip does not fail a build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902</WarningsNotAsErrors>

    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Product>Runova Website API</Product>
    <Company>Runova</Company>
    <Copyright>Runova</Copyright>
  </PropertyGroup>
</Project>
