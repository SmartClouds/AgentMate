<Project>
  <!-- One version per package for the whole solution. Bump here, never in a project file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The /health/ready check: asks the DbContext whether it can connect. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <!-- dotnet ef migrations, at design time only (PrivateAssets in the Data project). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Identity">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <!-- Keeps the Data Protection key ring, which seals API client signing keys, in PostgreSQL. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="OpenAPI">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- The reference page at /scalar, in Development and Staging only. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.6" />
  </ItemGroup>
  <ItemGroup Label="Mapping">
    <!-- A source generator: mappers are plain code at build time, no reflection at run time. -->
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>
  <ItemGroup Label="Content">
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Markdig" Version="1.5.1" />
  </ItemGroup>
  <ItemGroup Label="Images">
    <!-- Decodes uploads and re-encodes their pixels, which drops EXIF, XMP and every other metadata
         block. MIT licensed (ImageSharp from 3.2 needs a license key for Release builds, see T009).
         The Linux assets carry their own dependencies, so no fontconfig is needed in the container. -->
    <PackageVersion Include="SkiaSharp" Version="4.154.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
  </ItemGroup>
  <ItemGroup Label="Jobs">
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- Hangfire asks only for 11.0.1, which has a known vulnerability. Pinned transitively. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup Label="Errors and telemetry">
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <!-- Only ever published as a beta. EF Core itself emits no spans, so this is the way to get them. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="Sentry.AspNetCore" Version="6.12.1" />
    <!-- Links Sentry errors to the OpenTelemetry trace of the request they happened in. Replaces
         Sentry.OpenTelemetry, whose linking API is obsolete from 6.12. -->
    <PackageVersion Include="Sentry.OpenTelemetry.Exporter" Version="6.12.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
