---
import type { Thing } from 'schema-dts';
import {
  canonicalUrl,
  DEFAULT_OG_IMAGE,
  jsonLdGraph,
  pageTitle,
  SITE_NAME,
  serializeJsonLd,
} from '../lib/seo';

interface Props {
  /** The page title before the `| Runova` template. The home page leaves it out. */
  title?: string;
  /** 70 to 160 characters, unique per page. */
  description: string;
  image?: { src: string; alt: string; width: number; height: number };
  type?: 'website' | 'article';
  /** The page's own JSON-LD nodes; Organization and WebSite are always added first. */
  jsonLd?: Thing[];
  noindex?: boolean;
}

const { title, description, image, type = 'website', jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://runovahq.com');
const fullTitle = pageTitle(title);
const canonical = canonicalUrl(site, Astro.url);
const ogImage = image ?? {
  src: DEFAULT_OG_IMAGE.path,
  alt: DEFAULT_OG_IMAGE.alt,
  width: DEFAULT_OG_IMAGE.width,
  height: DEFAULT_OG_IMAGE.height,
};
const ogImageUrl = new URL(ogImage.src, site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={ogImage.alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImage.alt} />

<script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLdGraph(site, jsonLd))} />
