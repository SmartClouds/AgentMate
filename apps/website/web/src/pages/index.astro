---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  description="Runova runs your AI coding agents side by side with git, review, tests and deploys in one desktop app."
>
  <section class="py-24">
    <h1 class="max-w-[18ch] font-semibold text-[clamp(2.25rem,6vw,4rem)]">
      The Agentic Development Environment
    </h1>
    <p class="mt-6 max-w-[70ch] text-lg text-muted-foreground">
      This site is being built. Runova itself is ready: get it from
      <a
        href="https://github.com/SmartClouds/Runova/releases/latest"
        class="text-primary underline underline-offset-4">GitHub Releases</a
      >.
    </p>
  </section>
</BaseLayout>
