<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- LibraryImport pins arrays for the raw libc calls that simulate a crashed socket. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Runova.ServerCore\Runova.ServerCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Captured os-release files, /proc and command output from both OS families. -->
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The DevHost's pretend CA, so the fake the UI is built against is tested too. -->
  <ItemGroup>
    <Compile Include="..\..\src\Runova.ServerCore.DevHost\Fakes\FakeCertificates.cs" Link="DevHost\FakeCertificates.cs" />
    <Compile Include="..\..\src\Runova.ServerCore.DevHost\Fakes\SimulatedCompose.cs" Link="DevHost\SimulatedCompose.cs" />
    <Compile Include="..\..\src\Runova.ServerCore.DevHost\Fakes\FakeSsh.cs" Link="DevHost\FakeSsh.cs" />
    <Compile Include="..\..\src\Runova.ServerCore.DevHost\Fakes\FakeAssistant.cs" Link="DevHost\FakeAssistant.cs" />
  </ItemGroup>

  <!-- The compose lint parity fixture, shared with the app's linter in packages/core. -->
  <ItemGroup>
    <None Include="..\..\..\..\packages\core\src\deploy\compose\fixtures\lint-parity.*" Link="Fixtures\stacks\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The nginx renderer's golden files, read from next to the test binary. -->
  <ItemGroup>
    <None Include="Nginx\Golden\*.txt" Exclude="Nginx\Golden\*.received.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
