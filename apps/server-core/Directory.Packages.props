<Project>
  <!-- One version per package for the whole solution. Bump here, never in a project file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Data and identity">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- Design-time only (migrations), referenced by the DevHost so it never ships. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Contracts">
    <PackageVersion Include="Tapper.Attributes" Version="1.14.0" />
    <PackageVersion Include="TypedSignalR.Client.TypeScript.Attributes" Version="1.17.0" />
  </ItemGroup>
  <ItemGroup Label="Docker">
    <!-- The Testcontainers fork of Docker.DotNet (Engine API 29), over the Unix socket. -->
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.3.3" />
  </ItemGroup>
  <ItemGroup Label="DevHost">
    <!-- Reads compose files for the DevHost's simulated docker compose. Never in the release. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
