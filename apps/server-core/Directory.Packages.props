<Project>
  <!-- One version per package for the whole solution. Bump here, never in a project file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Data and identity">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- Design-time only (migrations), referenced by the DevHost so it never ships. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Contracts">
    <PackageVersion Include="Tapper.Attributes" Version="1.14.0" />
    <PackageVersion Include="TypedSignalR.Client.TypeScript.Attributes" Version="1.17.0" />
  </ItemGroup>
  <ItemGroup Label="Docker">
    <!-- The Testcontainers fork of Docker.DotNet (Engine API 29), over the Unix socket. -->
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.3.3" />
  </ItemGroup>
  <ItemGroup Label="Backups">
    <!-- Server backups (E28): Hangfire runs the schedules and uploads, stored in its own SQLite file. -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <!-- RaisedApp's storage (github.com/raisedapp), not the abandoned Hangfire.SQLite. -->
    <PackageVersion Include="Hangfire.Storage.SQLite" Version="0.4.3" />
    <!-- The cron parser Hangfire's own team publishes, for the next runs a plan screen shows. -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- Backup destinations: FTP and FTPS, and SFTP. -->
    <PackageVersion Include="FluentFTP" Version="55.1.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- A Telegram user account over MTProto (Wiz0u, MIT), for backups sent in parts. -->
    <PackageVersion Include="WTelegramClient" Version="4.4.9" />
  </ItemGroup>
  <ItemGroup Label="Error reporting">
    <!-- Error reporting (E29): the core sends its warnings and errors to a Sentry project as OpenTelemetry
         logs over OTLP/HTTP. Sentry takes OTLP directly, so no Sentry SDK is needed. -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Label="DevHost">
    <!-- Reads compose files for the DevHost's simulated docker compose. Never in the release. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
