<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The real server core host, listening on loopback TCP instead of the Unix socket, for UI work
    and for end-to-end tests on machines without Linux or systemd. Later epics wire fake platform,
    Docker and nginx state into it. Never published or shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentMate.ServerCore.DevHost</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- On Windows, time zones by IANA name (what the app sends for backup plans) need ICU, which
         Windows has; the real core runs on Linux and reads them from tzdata. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentMate.ServerCore\AgentMate.ServerCore.csproj" />
  </ItemGroup>

  <!-- The startup project for `dotnet ef`, so the design-time tooling stays out of the release. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
