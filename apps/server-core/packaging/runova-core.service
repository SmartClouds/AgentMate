# Runova Server Core. Installed by the Runova desktop app over SSH; ships inside each
# release tarball so the unit always matches the binary it starts.
#
# The core administers Docker, nginx, packages and the firewall, so it runs as root. It is reached
# only through its Unix socket, which systemd's runtime directory and the runova group limit
# to root and the group's members.

[Unit]
Description=Runova Server Core
Documentation=https://github.com/SmartClouds/Runova
After=network-online.target
Wants=network-online.target
# A release that keeps crashing stops being restarted instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# The core reports readiness itself, so `systemctl start` fails for a release that cannot start.
Type=notify
ExecStart=/opt/runova-core/current/runova-core serve
User=root
# Files the core creates, the socket included, belong to the runova group. UMask keeps them
# private; the core opens only the socket to the group (0660).
Group=runova
UMask=0077
RuntimeDirectory=runova-core
RuntimeDirectoryMode=0750
StateDirectory=runova-core
StateDirectoryMode=0700
ConfigurationDirectory=runova-core
ConfigurationDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
# No core dumps: a crashed core must not leave secrets on disk.
LimitCORE=0
LimitNOFILE=65536
# Hardening that does not change what the core's own work (packages, Docker, exec) sees; that
# work runs in transient units of its own.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1

[Install]
WantedBy=multi-user.target
