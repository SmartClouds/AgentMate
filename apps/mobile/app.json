{
  "expo": {
    "name": "Runova",
    "slug": "runova-remote",
    "scheme": "runova",
    "version": "2.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.runova.remote",
      "infoPlist": {
        "NSCameraUsageDescription": "Runova uses the camera to scan a pairing QR code shown on the Runova desktop app.",
        "NSLocalNetworkUsageDescription": "Runova connects to the Runova desktop app over your local Wi-Fi network to stream and control its screen.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.runova.remote",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0a0a0a"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Runova uses the camera to scan a pairing QR code shown on the Runova desktop app."
        }
      ],
      "@config-plugins/react-native-webrtc"
    ]
  }
}
