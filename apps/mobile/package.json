{
  "name": "@runova/mobile",
  "version": "1.63.0",
  "private": true,
  "main": "index.ts",
  "dependencies": {
    "@runova/protocol": "workspace:*",
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.11",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-webrtc": "^124.0.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.18",
    "event-target-shim": "6.0.2",
    "jest": "^30.5.1",
    "jest-expo": "~57.0.5",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src ./App.tsx ./index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=github-actions"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"],
    "testTimeout": 20000,
    "testMatch": ["<rootDir>/src/**/*.test.{ts,tsx}", "<rootDir>/App.test.tsx"],
    "moduleNameMapper": {
      "^@runova/protocol$": "<rootDir>/../../packages/protocol/src/index.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?(?:(?:jest-)?react-native|@react-native(?:-community)?|expo(?:nent)?|@expo(?:nent)?/.*|expo-.*|react-native-webrtc|react-native-safe-area-context|@react-native-async-storage/.*))"
    ],
    "collectCoverageFrom": ["src/**/*.{ts,tsx}", "App.tsx", "!src/theme/**"],
    "coverageReporters": ["text-summary", "json-summary", "lcov"]
  }
}
