{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/test/renderer/**/*",
    "src/preload/index.d.ts",
    "src/preload/deployDocker.ts",
    "src/preload/deployRegistry.ts",
    "src/preload/cloudflareServer.ts",
    "src/preload/deployHardening.ts",
    "src/preload/deployServerBackups.ts",
    "src/preload/deployDirectTls.ts",
    "src/preload/deployErrorReporting.ts",
    "src/preload/deployTelegram.ts",
    "src/preload/deployAssistant.ts",
    "src/preload/deployWordPress.ts",
    "src/preload/deployFiles.ts",
    "src/preload/health.ts",
    "src/preload/studio.ts",
    "src/preload/relay.ts",
    "src/preload/ciAutoFix.ts",
    "src/preload/errorTracking.ts",
    "src/preload/sftp.ts"
  ]
}
