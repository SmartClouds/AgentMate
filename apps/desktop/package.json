    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
