{
  "name": "@runova/desktop",
  "private": true,
  "version": "2.1.0",
  "description": "Runova desktop application",
  "homepage": "https://runovahq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmartClouds/Runova.git"
  },
  "author": {
    "name": "SmartClouds",
    "email": "info@smartclouds.co"
  },
  "main": "./out/main/index.mjs",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs",
    "dev": "pnpm rebuild:native && electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm rebuild:native && electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome lint ./src",
    "rebuild:native": "electron-rebuild -o better-sqlite3",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:unit": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run int.test ipc/vault.test backup/vaultSection.test",
    "test:coverage": "vitest run --coverage",
    "test:main": "vitest run --project main",
    "test:renderer": "vitest run --project renderer",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
